$TTL    604800
@       IN      SOA     dns.serafin.test. root.serafin.test. (
                            1       ; Serial
                            604800  ; Refresh
                            86400   ; Retry
                            2419200 ; Expire
                            604800 ) ; Negative Cache TTL
;
@               IN      NS      dns.serafin.test.
@               IN      NS      dhcp.serafin.test.

; Registros A
dns.serafin.test.    IN  A   192.168.58.10
dhcp.serafin.test.   IN  A   192.168.58.30
